BITRIX_WEBHOOK_URL=https://your-company.bitrix24.kz/rest/user/webhook/
BITRIX_IBLOCK_TYPE_ID=lists
BITRIX_IBLOCK_ID=115
BITRIX_STATUS_FIELD=PROPERTY_1249
BITRIX_ACTIVE_STATUS=4467

CLOCKSTER_API_BASE=https://api.clockster.com/company/v2
CLOCKSTER_TOKEN=replace_with_clockster_access_token

SYNC_MODE=dry-run
CLOCKSTER_TITLE_MAX=200
DEFAULT_LOCATION_RADIUS=

BITRIX_DEAL_CATEGORY_ID=69
BITRIX_DEAL_LOCATION_TITLE_FIELD=TITLE
BITRIX_DEAL_SELECT_FIELDS=ID,TITLE,CATEGORY_ID,STAGE_ID,CLOSED,DATE_MODIFY
DEAL_SYNC_CREATE_ENABLED=false

# Optional. Without a geocoder key, new locations are reported but not created.
GEOCODER_PROVIDER=none
GEOCODER_2GIS_KEY=
GOOGLE_GEOCODING_KEY=
GEOCODER_COUNTRY_SUFFIX=Казахстан
